APP_ENV=development
DEBUG=True
PROJECT_NAME="Intelligent Disaster Response & Relief Coordination"
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/disaster_db
ASYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/disaster_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase / Auth Configuration
FIREBASE_PROJECT_ID=projectk-2898

# LLM / AI Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
